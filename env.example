# Скопируй этот файл как .env и заполни нужные поля

# ── Обязательно ───────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=сюда_токен_от_botfather

# ── Нейросеть (хватит одного варианта) ───────────────────────
# Бесплатный ключ с openrouter.ai (рекомендуется)
OPENROUTER_API_KEY=sk-or-...

# GigaChat (Сбер)
# GIGACHAT_API_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat

# Mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Свой OpenAI-совместимый сервис
# EXTRA_BASE_URL=http://localhost:1234/v1
# EXTRA_KEY=
# EXTRA_MODEL=my-model

# Ollama (локально)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Опционально ───────────────────────────────────────────────
# Твой Telegram ID для команды /stats (узнать у @userinfobot)
# ADMIN_ID=123456789
